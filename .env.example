## Cấu hình môi trường — UniStudy CMC Sprint 1
## Sao chép file này thành .env và điền đúng thông tin SQL Server

# ── SQL Server ──────────────────────────────────────────────────
DB_SERVER=localhost
DB_NAME=UniStudy_Sprint1
DB_USER=sa
DB_PASSWORD=your_password_here
# Để trống nếu dùng Windows Authentication (DB_TRUSTED_CONNECTION=true)
DB_TRUSTED_CONNECTION=false
DB_PORT=1433
DB_ENCRYPT=false

# ── API Server ──────────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=unistudy_cmc_sprint1_secret_2026
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Môi trường ─────────────────────────────────────────────────
NODE_ENV=development
